{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/mv3/run.ts", "tests/mv3/collection.ts"],
  "exclude": ["dist-chrome", "dist-firefox", "legacy-mv2", "node_modules"]
}
