{
  "name": "pt-plugin-plus-mv3",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Manifest V3 continuation of PT-Plugin-Plus, based on the PT-depiler application framework",
  "homepage": "https://github.com/JohnathanT55/PT-Plugin-Plus",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:foundation": "tsc --project tsconfig.foundation.json",
    "test": "tsx tests/mv3/run.ts",
    "build": "vite build",
    "build:firefox": "cross-env TARGET=firefox vite build",
    "validate": "node scripts/validate-mv3.js",
    "test:runtime": "node tests/mv3/worker-runtime.js",
    "verify": "pnpm typecheck && pnpm typecheck:foundation && pnpm test && pnpm build && pnpm validate && pnpm test:runtime",
    "format": "prettier --write app vite.config.ts scripts tests src"
  },
  "dependencies": {
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "@webext-core/job-scheduler": "^1.1.0",
    "@webext-core/messaging": "^3.0.2",
    "@webext-core/storage": "^1.2.1",
    "axios": "1.18.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.49.0",
    "file-saver": "^2.0.5",
    "filesize": "^11.0.22",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "nanoid": "^6.0.0",
    "p-queue": "^9.3.1",
    "parse-torrent": "^11.0.21",
    "pinia": "^3.0.4",
    "pinia-plugin-state-persistence": "^1.11.0",
    "search-query-parser": "^1.6.0",
    "sizzle": "^2.3.10",
    "url-join": "^5.0.0",
    "urlencode": "^2.0.0",
    "valid-filename": "^4.0.0",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.6",
    "vue-konva": "^3.4.0",
    "vue-router": "^5.2.0",
    "vuetify": "^3.12.7",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/chrome": "^0.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/git-rev-sync": "^2.0.2",
    "@types/node": "^26.1.1",
    "@types/parse-torrent": "^5.8.8",
    "@types/sizzle": "^2.3.10",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^10.1.0",
    "git-rev-sync": "^3.0.2",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vite": "^6.4.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-web-extension": "4.5.1",
    "vue-tsc": "^3.3.7"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf"
  }
}
